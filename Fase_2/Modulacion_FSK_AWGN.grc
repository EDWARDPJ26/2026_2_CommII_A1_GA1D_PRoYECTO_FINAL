options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: 'FSK con ruido AWGN: envolvente compleja, PSD y frecuencia instantanea'
    copyright: ''
