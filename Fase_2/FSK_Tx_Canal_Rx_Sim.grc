  parameters: {affinity: '', alias: '', comment: 'bit 1 -> +df, bit 0 -> -df', label: "Desviaci\xF3n FSK \u0394f (Hz)", rangeType: float, value: '20000', start: '5000', stop: '100000', step: '1000', widget: counter_slider, orient: QtCore.Qt.Horizontal, min_len: '200', gui_hint: '0,0,1,1'}
  states:
