options:
  parameters: {author: '', catch_exceptions: 'True', category: '[GRC Hier Blocks]', cmake_opt: '', comment: 'Fase 2 - Guia 2: Tx conformado + canal AWGN + receptor disenado', copyright: '', description: 'Simulacion BFSK 10 kbps, df=20 kHz, canal AWGN y receptor con ojo, bits y BER', gen_cmake: 'On', gen_linking: dynamic, generate_options: qt_gui, hier_block_src_path: '.:', id: FSK_Tx_Canal_Rx_Sim, max_nouts: '0', output_language: python, placement: '(0,0)', qt_qss_theme: '', realtime_scheduling: '', run: 'True', run_command: '{python} -u {filename}', run_options: prompt, sizing_mode: fixed, thread_safe_setters: '', title: FSK Tx-Canal-Rx (Guia 2) - Telemetria industrial, window_size: '(1500,1100)'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters: {comment: 'Tasa de muestreo: 100 MHz/100 en el USRP y 8 MS/s/8 en el HackRF', value: 1e6}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters: {comment: Muestras por simbolo, value: '100'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 12]
    rotation: 0
    state: enabled
- name: symbol_rate
  id: variable
  parameters: {comment: Rs = 10 kbaud (telemetria industrial), value: samp_rate/sps}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 12]
    rotation: 0
    state: enabled
- name: Rb
  id: variable
  parameters: {comment: 'BFSK binaria: Rb = Rs = 10 kbps', value: symbol_rate}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 12]
    rotation: 0
    state: enabled
- name: ber_window
