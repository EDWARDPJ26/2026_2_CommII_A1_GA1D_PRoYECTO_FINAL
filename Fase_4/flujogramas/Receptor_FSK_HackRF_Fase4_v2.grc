- name: e_BER_CSV
  id: epy_block
  parameters:
    EbN0_max: EbN0_max
    EbN0_min: EbN0_min
    EbN0_step: EbN0_step
    _source_code: "import numpy as np\nfrom gnuradio import gr\nfrom pathlib import\
      \ Path\nimport csv\nimport time\n\n\nclass blk(gr.sync_block):\n\n    def __init__(self,\n\
      \                 EbN0_min=0.0,\n                 EbN0_max=18.0,  # Ajuste Fase\
      \ 4: GRC dimensiona los puertos con este valor (debe ser = EbN0_max)\n     \
      \            EbN0_step=1.0,\n                 nombre_archivo=\"curva_BER.csv\"\
      ,\n                 guardar_cada=2.0):\n\n        self.EbN0_min = float(EbN0_min)\n\
      \        self.EbN0_max = float(EbN0_max)\n        self.EbN0_step = float(EbN0_step)\n\
      \n        self.N = int(round(\n            (self.EbN0_max - self.EbN0_min) /\n\
      \            self.EbN0_step\n        )) + 1\n\n        gr.sync_block.__init__(\n\
      \            self,\n            name='Guardar curva BER en CSV',\n         \
      \   in_sig=[\n                (np.float32, self.N),\n                (np.float32,\
      \ self.N)\n            ],\n            out_sig=None\n        )\n\n        self.nombre_archivo\
      \ = str(nombre_archivo)\n        self.guardar_cada = float(guardar_cada)\n\n\
      \        # El Embedded Python Block se genera junto al flowgraph de GNU Radio.\n\
      \        # Por ello el CSV queda en la misma carpeta contenedora del .grc/.py.\n\
      \        # Ajuste Fase 4: compatibilidad GNU Radio 3.10\n        self.carpeta\
      \ = Path(__file__).resolve().parent if '__file__' in globals() else Path.cwd()\n\
      \        self.ruta_csv = self.carpeta / self.nombre_archivo\n\n        self.ultimo_guardado\
      \ = 0.0\n        self.ebn0 = self.EbN0_min + self.EbN0_step * np.arange(self.N)\n\
      \n        print(\"CSV BER se guardar\xE1 en:\")\n        print(self.ruta_csv)\n\
      \n    def guardar(self, ber, logber):\n        archivo_temporal = self.ruta_csv.with_suffix(\"\
      .tmp\")\n\n        with open(archivo_temporal, \"w\", newline=\"\", encoding=\"\
      utf-8\") as f:\n            writer = csv.writer(f)\n            writer.writerow([\"\
      EbN0_dB\", \"BER\", \"log10_BER\"])\n\n            for eb, b, lb in zip(self.ebn0,\
      \ ber, logber):\n                writer.writerow([\n                    f\"\
      {eb:.6f}\",\n                    f\"{float(b):.12e}\",\n                   \
      \ f\"{float(lb):.12e}\"\n                ])\n\n        # Ajuste Fase 4: si otro\
      \ programa tiene el CSV abierto (visor, Excel),\n        # Windows impide reemplazarlo.\
      \ Antes eso detenia el bloque y atascaba\n        # el flujograma; ahora se\
      \ reintenta en el siguiente guardado.\n        try:\n            archivo_temporal.replace(self.ruta_csv)\n\
      \        except OSError:\n            pass\n\n    def work(self, input_items,\
      \ output_items):\n        ber_vectors = input_items[0]\n        log_vectors\
      \ = input_items[1]\n\n        if len(ber_vectors) == 0:\n            return\
      \ 0\n\n        ahora = time.time()\n        if ahora - self.ultimo_guardado\
      \ >= self.guardar_cada:\n            try:\n                self.guardar(ber_vectors[-1],\
      \ log_vectors[-1])\n            except OSError as e:  # Ajuste Fase 4: nunca\
      \ detener el flujograma\n                print('[e_BER_CSV] no se pudo guardar\
      \ (se reintenta):', e)\n            self.ultimo_guardado = ahora\n\n       \
      \ return len(ber_vectors)\n"
    affinity: ''
    alias: ''
    comment: 'Guarda la curva en Fase4/curva_BER.csv

      Cada corrida lo sobrescribe: renombrarlo al terminar (ascii / pn9)'
