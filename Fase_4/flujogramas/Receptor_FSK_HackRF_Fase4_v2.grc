options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: 'Receptor FSK con HackRF One (Tx: USRP 2920)'
    copyright: ''
    description: Receptor FSK con instrumentacion BER (e_EbN0_Sweep + e_BER_Curve)
      y verificacion del texto de telemetria
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: Receptor_FSK_HackRF_Fase4_v2
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'Receptor FSK - HackRF One (Fase 4 v2: medicion BER, Rx liviano)'
    window_size: (1400,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [32, 4.0]
    rotation: 0
    state: enabled

blocks:
- name: EbN0_max
  id: variable
  parameters:
    comment: Subido de 14 a 18 dB para cruzar BER = 1e-3 con margen
    value: '18'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1512, 12]
    rotation: 0
    state: enabled
- name: EbN0_min
  id: variable
  parameters:
    comment: ''
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1400, 12]
    rotation: 0
    state: enabled
- name: EbN0_step
  id: variable
  parameters:
    comment: ''
    value: '1.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1624, 12]
    rotation: 0
    state: enabled
- name: N_EbN0
  id: variable
  parameters:
    comment: ''
    value: int(round((EbN0_max-EbN0_min)/EbN0_step))+1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1736, 12]
    rotation: 0
    state: enabled
- name: Rb
  id: variable
  parameters:
    comment: 'BFSK: Rb = Rs = 10 kbps'
    value: symbol_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1848, 12]
    rotation: 0
    state: enabled
- name: bb_rate
  id: variable
  parameters:
    comment: Tasa I/Q a la entrada del Rx digital (1 MS/s)
    value: samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1256, 84.0]
    rotation: 0
    state: enabled
- name: bits_guardia
  id: variable
  parameters:
    comment: ''
    value: '1000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
