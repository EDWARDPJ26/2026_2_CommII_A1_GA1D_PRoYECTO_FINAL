- name: trama_telemetria
  id: epy_module
  parameters:
    alias: ''
    comment: Arma la trama. El mismo modulo va en el receptor.
    source_code: "\"\"\"\ntrama_telemetria\nArma la trama de telemetria de la Fase\
      \ 4 (formato tipo IEEE 802.15.4g SUN-FSK):\n\n    [preambulo 32 bits 0x55555555][SFD\
      \ 16 bits 0x904E][carga: mensaje ASCII, MSB primero]\n\nSi pn9 = 1, la carga\
      \ se blanquea con la secuencia PN9 (x^9 + x^5 + 1, semilla 0x1FF).\nEl preambulo\
      \ y el SFD nunca se blanquean, para poder detectarlos en el receptor.\n\nEl\
      \ mismo modulo va en el transmisor y en el receptor, para que ambos tengan\n\
      exactamente la misma secuencia de referencia.\n\"\"\"\n\nPREAMBULO = 0x55555555\n\
      PREAMBULO_BITS = 32\nSFD = 0x904E\nSFD_BITS = 16\n\n\ndef entero_a_bits(valor,\
      \ n):\n    \"\"\"Entero -> lista de n bits, MSB primero.\"\"\"\n    return [(valor\
      \ >> (n - 1 - i)) & 1 for i in range(n)]\n\n\ndef bytes_a_bits(datos):\n   \
      \ \"\"\"Bytes -> lista de bits, MSB primero en cada byte.\"\"\"\n    return\
      \ [(b >> (7 - i)) & 1 for b in datos for i in range(8)]\n\n\ndef bits_a_bytes(bits):\n\
      \    \"\"\"Lista de bits (MSB primero) -> bytes. Ignora los bits sobrantes.\"\
      \"\"\n    datos = bytearray()\n    for k in range(0, len(bits) - 7, 8):\n  \
      \      b = 0\n        for bit in bits[k:k + 8]:\n            b = (b << 1) |\
      \ (int(bit) & 1)\n        datos.append(b)\n    return bytes(datos)\n\n\ndef\
      \ secuencia_pn9(n):\n    \"\"\"n bits de la PN9 (x^9 + x^5 + 1) con semilla\
      \ 0x1FF.\"\"\"\n    estado = 0x1FF\n    salida = []\n    for _ in range(n):\n\
      \        salida.append(estado & 1)\n        nuevo = (estado ^ (estado >> 5))\
      \ & 1\n        estado = (estado >> 1) | (nuevo << 8)\n    return salida\n\n\n\
      def blanquear(bits):\n    \"\"\"XOR con la PN9. Aplicarlo dos veces devuelve\
      \ los bits originales.\"\"\"\n    return [b ^ p for b, p in zip(bits, secuencia_pn9(len(bits)))]\n\
      \n\ndef carga_bits(mensaje, pn9=0):\n    \"\"\"Bits de la carga (mensaje ASCII),\
      \ blanqueados si pn9 = 1.\"\"\"\n    bits = bytes_a_bits(str(mensaje).encode('ascii',\
      \ errors='replace'))\n    return blanquear(bits) if int(pn9) else bits\n\n\n\
      def construir_trama(mensaje, pn9=0):\n    \"\"\"Trama completa como lista de\
      \ bits 0/1.\"\"\"\n    return (entero_a_bits(PREAMBULO, PREAMBULO_BITS)\n  \
      \          + entero_a_bits(SFD, SFD_BITS)\n            + carga_bits(mensaje,\
      \ pn9))\n\n\ndef decodificar_carga(bits, pn9=0):\n    \"\"\"Bits de carga recibidos\
      \ -> texto (para el receptor).\"\"\"\n    bits = [int(b) & 1 for b in bits]\n\
      \    if int(pn9):\n        bits = blanquear(bits)\n    return bits_a_bytes(bits).decode('ascii',\
      \ errors='replace')\n"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1728, 120.0]
    rotation: 0
    state: enabled

