- name: e_BER_Curve
  id: epy_block
  parameters:
    EbN0_max: EbN0_max
    EbN0_min: EbN0_min
    EbN0_step: EbN0_step
    _source_code: "\"\"\"\ne_BER_Curve\nAcumulador de curva BER para los sistemas\
      \ de los estudiantes.\n\nEntrada 0 : bits transmitidos de referencia (byte 0/1).\n\
      Entrada 1 : bits recuperados por el receptor (byte 0/1).\n\nSalida 0  : vector\
      \ BER lineal.\nSalida 1  : vector log10(BER) para QT GUI Vector Sink.\n\nEl\
      \ bloque usa exactamente el mismo barrido que e_EbN0_Sweep. Para cada punto:\n\
      - ignora bits_guardia al comienzo del segmento;\n- compara bits_por_punto;\n\
      - cuando el barrido vuelve a un punto, sigue acumulando estad\xEDsticas.\n\n\
      delay_bits retrasa internamente la referencia Tx para compensar el retardo\n\
      del receptor. Se ajusta primero en una condici\xF3n limpia hasta lograr BER\u2248\
      0.\n\nCuando todav\xEDa no se observa ning\xFAn error, la salida logar\xEDtmica\
      \ utiliza\n3/N como cota superior aproximada para poder mostrar el punto sin\
      \ afirmar\nque BER=0.\n\"\"\"\n\nimport numpy as np\nimport pmt\nfrom collections\
      \ import deque\nfrom gnuradio import gr\n\n\nclass blk(gr.decim_block):  # Ajuste\
      \ Fase 4: compatibilidad GNU Radio 3.10\n    def __init__(self,\n          \
      \       EbN0_min=0.0,\n                 EbN0_max=18.0,  # Ajuste Fase 4: GRC\
      \ dimensiona los puertos con este valor (debe ser = EbN0_max)\n            \
      \     EbN0_step=1.0,\n                 bits_por_punto=100000,\n            \
      \     bits_guardia=1000,\n                 delay_bits=0,\n                 update_every=1000,\n\
      \                 segmentos_arranque=3,  # Ajuste Fase 4: descartar el arranque\n\
      \                 descartar_antes=8000,  # Ajuste Fase 4 v2: bits previos a\
      \ un realineo\n                 descartar_despues=1000):  # Ajuste Fase 4 v2:\
      \ bits posteriores\n        self.EbN0_min = float(EbN0_min)\n        self.EbN0_max\
      \ = float(EbN0_max)\n        self.EbN0_step = float(EbN0_step)\n        self.bits_por_punto\
      \ = max(1, int(bits_por_punto))\n        self.bits_guardia = max(0, int(bits_guardia))\n\
      \        self.delay_bits = max(0, int(delay_bits))\n        self.update_every\
      \ = max(1, int(update_every))\n        # Ajuste Fase 4 (hardware): no contar\
      \ los primeros segmentos de la PRIMERA\n        # pasada (overflows al abrir\
      \ la GUI y alineacion de la referencia). La\n        # asignacion de puntos\
      \ no cambia; esos puntos se miden en pasadas siguientes.\n        self.segmentos_arranque\
      \ = max(0, int(segmentos_arranque))\n        # Ajuste Fase 4 v2 (hardware):\
      \ si se pierden muestras (overflow del HackRF,\n        # underrun del USRP)\
      \ la referencia se desalinea hasta que e_Ref_Alineada lo\n        # detecta\
      \ y emite el tag 'realineo'. Los bits comparados en ese lapso no son\n     \
      \   # errores del receptor: se retienen descartar_antes bits sin contar y, ante\n\
      \        # un tag, se descartan junto con los descartar_despues siguientes.\n\
      \        self.descartar_antes = max(0, int(descartar_antes))\n        self.descartar_despues\
      \ = max(0, int(descartar_despues))\n        self.pendientes = deque()   # (point_index,\
      \ error) aun sin contar\n        self.saltar_hasta = -1      # indice absoluto\
      \ hasta el que se ignoran bits\n        self.descartados = 0\n        self.realineos\
      \ = 0\n        self.contados = 0\n\n        if self.EbN0_step <= 0:\n      \
      \      raise ValueError(\"EbN0_step debe ser > 0\")\n        if self.EbN0_max\
      \ < self.EbN0_min:\n            raise ValueError(\"EbN0_max debe ser >= EbN0_min\"\
      )\n\n        npts = int(round((self.EbN0_max-self.EbN0_min)/self.EbN0_step))\
      \ + 1\n        self.eb_axis = self.EbN0_min + self.EbN0_step*np.arange(npts,\
      \ dtype=np.float64)\n        self.N = len(self.eb_axis)\n        self.segment_bits\
      \ = self.bits_guardia + self.bits_por_punto\n\n        # Ajuste Fase 4: compatibilidad\
      \ GNU Radio 3.10\n        gr.decim_block.__init__(\n            self,\n    \
      \        name='e_BER_Curve',\n            in_sig=[np.int8, np.int8],\n     \
      \       out_sig=[(np.float32, self.N), (np.float32, self.N)],\n            decim=self.update_every\n\
      \        )\n\n        self.tx_fifo = deque([0]*self.delay_bits)\n        self.raw_items\
      \ = 0\n        self.valid_bit_index = 0\n\n        self.count = np.zeros(self.N,\
      \ dtype=np.int64)\n        self.errors = np.zeros(self.N, dtype=np.int64)\n\
      \        self.set_tag_propagation_policy(gr.TPP_DONT)\n\n    def _realineo(self,\
      \ abs_idx):\n        n = len(self.pendientes)\n        self.pendientes.clear()\n\
      \        self.saltar_hasta = abs_idx + self.descartar_despues\n        self.descartados\
      \ += n + self.descartar_despues\n        self.realineos += 1\n        total\
      \ = self.descartados + self.contados\n        print('[e_BER_Curve] realineo\
      \ #%d: %d bits descartados (acumulado %.2f %% de los bits)'\n              %\
      \ (self.realineos, n + self.descartar_despues,\n                 100.0 * self.descartados\
      \ / max(1, total)))\n\n    def _contar(self, point_index, error):\n        self.pendientes.append((point_index,\
      \ error))\n        while len(self.pendientes) > self.descartar_antes:\n    \
      \        p, e = self.pendientes.popleft()\n            self.count[p] += 1\n\
      \            self.errors[p] += e\n            self.contados += 1\n\n    def\
      \ _process(self, tx, rx, abs0=0, marcas=()):\n        for k, (t, r) in enumerate(zip(tx,\
      \ rx)):\n            abs_idx = abs0 + k\n            if abs_idx in marcas:\n\
      \                self._realineo(abs_idx)\n            tb = int(t) & 1\n    \
      \        rb = int(r) & 1\n\n            if self.delay_bits > 0:\n          \
      \      self.tx_fifo.append(tb)\n                t_aligned = self.tx_fifo.popleft()\n\
      \                if self.raw_items < self.delay_bits:\n                    self.raw_items\
      \ += 1\n                    continue\n            else:\n                t_aligned\
      \ = tb\n\n            bit_index = self.valid_bit_index\n            segment_index\
      \ = bit_index // self.segment_bits\n            point_index = segment_index\
      \ % self.N\n            pos = bit_index % self.segment_bits\n\n            #\
      \ Dejar que filtros/sincronizadores se estabilicen despu\xE9s\n            #\
      \ del cambio de nivel de ruido.\n            if (pos >= self.bits_guardia and\
      \ segment_index >= self.segmentos_arranque\n                    and abs_idx\
      \ > self.saltar_hasta):\n                self._contar(point_index, 1 if t_aligned\
      \ != rb else 0)\n\n            self.valid_bit_index += 1\n            self.raw_items\
      \ += 1\n\n    def _vectors(self):\n        ber = np.zeros(self.N, dtype=np.float32)\n\
      \        logber = np.zeros(self.N, dtype=np.float32)\n\n        for i in range(self.N):\n\
      \            n = int(self.count[i])\n            e = int(self.errors[i])\n\n\
      \            if n <= 0:\n                ber[i] = 0.0\n                logber[i]\
      \ = 0.0\n            elif e > 0:\n                b = e/float(n)\n         \
      \       ber[i] = b\n                logber[i] = np.log10(max(b, 1e-12))\n  \
      \          else:\n                # BER observado = 0; para la gr\xE1fica usamos\
      \ una cota superior.\n                ber[i] = 0.0\n                upper =\
      \ min(1.0, 3.0/float(n))\n                logber[i] = np.log10(max(upper, 1e-12))\n\
      \n        return ber, logber\n\n    def work(self, input_items, output_items):\n\
      \        tx = input_items[0]\n        rx = input_items[1]\n        out_ber =\
      \ output_items[0]\n        out_log = output_items[1]\n\n        nout = len(out_ber)\n\
      \        D = self.update_every\n        base = self.nitems_read(0)\n       \
      \ marcas = set(t.offset for t in self.get_tags_in_window(\n            0, 0,\
      \ min(len(tx), nout * D), pmt.intern('realineo')))\n\n        for k in range(nout):\n\
      \            a = k*D\n            b = min((k+1)*D, len(tx))\n            if\
      \ a < b:\n                self._process(tx[a:b], rx[a:b], base + a, marcas)\n\
      \n            ber, logber = self._vectors()\n            out_ber[k, :] = ber\n\
      \            out_log[k, :] = logber\n\n        return nout\n"
    affinity: ''
    alias: ''
    bits_guardia: bits_guardia
    bits_por_punto: bits_por_punto
    comment: 'Entrada 0: bits Tx de referencia

      Entrada 1: bits Rx (slicer)'
    delay_bits: delay_bits
    descartar_antes: '8000'
    descartar_despues: '1000'
    maxoutbuf: '0'
    minoutbuf: '0'
    segmentos_arranque: '3'
    update_every: update_every
  states:
    _io_cache: ('e_BER_Curve', 'blk', [('EbN0_min', '0.0'), ('EbN0_max', '18.0'),
      ('EbN0_step', '1.0'), ('bits_por_punto', '100000'), ('bits_guardia', '1000'),
      ('delay_bits', '0'), ('update_every', '1000'), ('segmentos_arranque', '3'),
      ('descartar_antes', '8000'), ('descartar_despues', '1000')], [('0', 'byte',
      1), ('1', 'byte', 1)], [('0', 'float', 19), ('1', 'float', 19)], '', ['EbN0_max',
      'EbN0_min', 'EbN0_step', 'bits_guardia', 'bits_por_punto', 'delay_bits', 'descartar_antes',
      'descartar_despues', 'segmentos_arranque', 'update_every'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2976, 440.0]
    rotation: 0
    state: enabled
- name: e_EbN0_Sweep
  id: epy_block
  parameters:
    EbN0_max: EbN0_max
    EbN0_min: EbN0_min
    EbN0_step: EbN0_step
    _source_code: "\"\"\"\ne_EbN0_Sweep\nInstrumento para caracterizaci\xF3n BER con\
      \ un enlace SDR ya funcional.\n\nEntrada 0 : se\xF1al compleja I/Q recibida\
      \ del SDR (preferiblemente DESPU\xC9S\n            de la adaptaci\xF3n radio_rate\
      \ -> bb_rate).\nSalida 0  : la misma se\xF1al I/Q con AWGN adicional controlado.\n\
      Salida 1  : valor instant\xE1neo de Eb/N0 [dB] usado en el barrido.\n\nEl bloque\
      \ NO sustituye el USRP/HackRF ni el receptor. Se inserta entre\nla salida I/Q\
      \ del SDR y la entrada del receptor digital.\n\nEl barrido se hace por segmentos\
      \ contiguos. Cada punto se mantiene durante:\n    bits_guardia + bits_por_punto\n\
      \nLa potencia de ruido artificial se calcula a partir de la potencia promedio\n\
      medida ANTES de agregar el ruido:\n\n    Eb = Ps / Rb\n    N0 = Eb / (Eb/N0)\n\
      \    Pn = N0 * Fs\n\npor lo tanto:\n\n    Pn = Ps * Fs / (Rb * 10**(EbN0_dB/10))\n\
      \nEl ruido complejo se genera con varianza total Pn.\n\"\"\"\n\nimport numpy\
      \ as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    def __init__(self,\n\
      \                 EbN0_min=0.0,\n                 EbN0_max=14.0,\n         \
      \        EbN0_step=1.0,\n                 samp_rate=256000.0,\n            \
      \     bit_rate=64000.0,\n                 bits_por_punto=100000,\n         \
      \        bits_guardia=1000,\n                 signal_power=0.0,\n          \
      \       seed=2026):\n        gr.sync_block.__init__(\n            self,\n  \
      \          name='e_EbN0_Sweep',\n            in_sig=[np.complex64],\n      \
      \      out_sig=[np.complex64, np.float32]\n        )\n\n        self.EbN0_min\
      \ = float(EbN0_min)\n        self.EbN0_max = float(EbN0_max)\n        self.EbN0_step\
      \ = float(EbN0_step)\n        self.samp_rate = float(samp_rate)\n        self.bit_rate\
      \ = float(bit_rate)\n        self.bits_por_punto = max(1, int(bits_por_punto))\n\
      \        self.bits_guardia = max(0, int(bits_guardia))\n        self.signal_power_cfg\
      \ = float(signal_power)\n\n        if self.EbN0_step <= 0:\n            raise\
      \ ValueError(\"EbN0_step debe ser > 0\")\n        if self.samp_rate <= 0 or\
      \ self.bit_rate <= 0:\n            raise ValueError(\"samp_rate y bit_rate deben\
      \ ser > 0\")\n        if self.EbN0_max < self.EbN0_min:\n            raise ValueError(\"\
      EbN0_max debe ser >= EbN0_min\")\n\n        npts = int(round((self.EbN0_max-self.EbN0_min)/self.EbN0_step))\
      \ + 1\n        self.eb_axis = self.EbN0_min + self.EbN0_step*np.arange(npts,\
      \ dtype=np.float64)\n        self.segment_bits = self.bits_guardia + self.bits_por_punto\n\
      \n        self.sample_count = 0\n        self.power_sum = 0.0\n        self.power_count\
      \ = 0\n        self.rng = np.random.default_rng(int(seed))\n\n    def _signal_power(self,\
      \ x):\n        if self.signal_power_cfg > 0:\n            return self.signal_power_cfg\n\
      \n        # Promedio acumulado de la se\xF1al recibida ANTES del ruido artificial.\n\
      \        self.power_sum += float(np.sum(np.abs(x.astype(np.complex128))**2))\n\
      \        self.power_count += len(x)\n        if self.power_count <= 0:\n   \
      \         return 0.0\n        return max(self.power_sum/self.power_count, 1e-20)\n\
      \n    def work(self, input_items, output_items):\n        x = input_items[0]\n\
      \        y = output_items[0]\n        eb_out = output_items[1]\n        n =\
      \ len(x)\n        if n == 0:\n            return 0\n\n        Ps = self._signal_power(x)\n\
      \n        # \xCDndice absoluto de muestra -> \xEDndice equivalente de bit.\n\
      \        s = self.sample_count + np.arange(n, dtype=np.float64)\n        bit_index\
      \ = np.floor(s*self.bit_rate/self.samp_rate).astype(np.int64)\n\n        segment_index\
      \ = bit_index // self.segment_bits\n        point_index = np.mod(segment_index,\
      \ len(self.eb_axis))\n        ebn0_db = self.eb_axis[point_index]\n        ebn0_lin\
      \ = np.power(10.0, ebn0_db/10.0)\n\n        # Potencia total del ruido complejo\
      \ por muestra.\n        noise_power = Ps*self.samp_rate/(self.bit_rate*ebn0_lin)\n\
      \        sigma_iq = np.sqrt(np.maximum(noise_power, 0.0)/2.0)\n\n        noise\
      \ = (\n            self.rng.standard_normal(n)*sigma_iq\n            + 1j*self.rng.standard_normal(n)*sigma_iq\n\
      \        ).astype(np.complex64)\n\n        y[:] = x + noise\n        eb_out[:]\
      \ = ebn0_db.astype(np.float32)\n\n        self.sample_count += n\n        return\
      \ n\n"
    affinity: ''
    alias: ''
    bit_rate: Rb
    bits_guardia: bits_guardia
    bits_por_punto: bits_por_punto
    comment: 'Instrumento: AWGN controlado (barrido de Eb/N0)'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: bb_rate
    seed: '2026'
    signal_power: '0.0'
  states:
    _io_cache: ('e_EbN0_Sweep', 'blk', [('EbN0_min', '0.0'), ('EbN0_max', '14.0'),
      ('EbN0_step', '1.0'), ('samp_rate', '256000.0'), ('bit_rate', '64000.0'), ('bits_por_punto',
      '100000'), ('bits_guardia', '1000'), ('signal_power', '0.0'), ('seed', '2026')],
      [('0', 'complex', 1)], [('0', 'complex', 1), ('1', 'float', 1)], '', ['EbN0_max',
      'EbN0_min', 'EbN0_step', 'bit_rate', 'bits_guardia', 'bits_por_punto', 'samp_rate'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 360]
    rotation: 0
    state: enabled
- name: e_Ref_Alineada
  id: epy_block
  parameters:
    _source_code: "\"\"\"\ne_Ref_Alineada\nGenera la referencia Tx (la trama de telemetria\
      \ repetida) ALINEADA con los bits\nrecuperados, para que e_BER_Curve trabaje\
      \ con delay_bits = 0.\n\nSe usa porque el Tx y el Rx corren en computadores\
      \ distintos: el desfase entre\nla trama recibida y una referencia local cambia\
      \ en cada ejecucion, y la deriva\nde reloj puede desplazarlo durante la medicion.\n\
      \nEntrada 0 : bits recuperados por el receptor (byte 0/1).\nSalida 0  : bit\
      \ de referencia correspondiente a cada bit recibido (byte 0/1).\n\nMetodo: correlacion\
      \ circular de los bits recibidos (+-1) con la trama conocida,\nacumulada hasta\
      \ que el pico es estadisticamente claro (z >= z_min). Entonces se\nfija el desfase.\
      \ Ya alineada, corrige cualquier salto (busqueda global; Ajuste\nFase 4) con\
      \ la misma exigencia estadistica. max_salto ya no se usa. Funciona aun con BER\
      \ alta: a menor\nEb/N0 solo tarda mas en decidir. La referencia NO copia bits\
      \ del receptor:\nsiempre es la trama conocida, desplazada el desfase elegido.\n\
      \"\"\"\n\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\n\nclass\
      \ blk(gr.sync_block):\n    def __init__(self, trama=(0, 1), z_min=10.0, max_salto=3,\
      \ min_bits=2000, max_bits=20000):\n        gr.sync_block.__init__(\n       \
      \     self,\n            name='e_Ref_Alineada',\n            in_sig=[np.int8],\n\
      \            out_sig=[np.int8]\n        )\n        self.trama = np.array(trama,\
      \ dtype=np.int8) & 1\n        self.L = len(self.trama)\n        self.t_pm =\
      \ 2.0 * self.trama - 1.0\n        self.T_fft = np.conj(np.fft.fft(self.t_pm))\n\
      \        self.z_min = float(z_min)\n        self.max_salto = int(max_salto)\n\
      \        self.min_bits = int(min_bits)\n        self.max_bits = int(max_bits)\n\
      \n        self.n = 0                  # indice absoluto del proximo bit recibido\n\
      \        self.desfase = None         # d: ref[n] = trama[(n - d) % L]\n    \
      \    self.acc = np.zeros(self.L)\n        self.acc_bits = 0\n        self.cambios\
      \ = 0\n        self.marcar = False   # Ajuste Fase 4 v2: avisar a e_BER_Curve\n\
      \        self.set_tag_propagation_policy(gr.TPP_DONT)\n\n    def _decidir(self):\n\
      \        # c[d] = sum_n rx_pm[n] * t_pm[(n - d) % L]\n        c = np.real(np.fft.ifft(np.fft.fft(self.acc)\
      \ * self.T_fft))\n        sigma = np.sqrt(self.acc_bits)  # desviacion de c[d]\
      \ para un desfase incorrecto\n        if self.desfase is None:\n           \
      \ d = int(np.argmax(c))\n            if c[d] / sigma < self.z_min:\n       \
      \         return\n        else:\n            # Ajuste Fase 4 (hardware): realineacion\
      \ GLOBAL. Un overflow del HackRF o un\n            # underrun del USRP puede\
      \ saltar mas de +-max_salto bits; antes el bloque\n            # quedaba desalineado\
      \ para siempre (BER ~0.4 con el texto llegando bien).\n            # Ahora se\
      \ busca en todos los desfases, con la misma exigencia (z >= z_min).\n      \
      \      d = int(np.argmax(c))\n            if d == self.desfase:\n          \
      \      # Desfase actual confirmado: reiniciar la ventana para detectar\n   \
      \             # rapido un salto futuro. Si aun no hay evidencia, seguir acumulando.\n\
      \                if c[d] / sigma >= self.z_min or self.acc_bits >= self.max_bits:\n\
      \                    self.acc[:] = 0.0\n                    self.acc_bits =\
      \ 0\n                return\n            if (c[d] - c[self.desfase]) / sigma\
      \ < self.z_min:\n                # Sin evidencia suficiente: seguir acumulando\
      \ (hasta max_bits)\n                if self.acc_bits >= self.max_bits:\n   \
      \                 self.acc[:] = 0.0\n                    self.acc_bits = 0\n\
      \                return\n        z = c[d] / sigma\n        if d != self.desfase:\n\
      \            if self.desfase is not None:\n                self.cambios += 1\n\
      \                print('[e_Ref_Alineada] desfase corregido: %d -> %d bits (z\
      \ = %.1f)'\n                      % (self.desfase, d, z))\n            else:\n\
      \                print('[e_Ref_Alineada] alineada: desfase = %d bits (z = %.1f,\
      \ %d bits)'\n                      % (d, z, self.acc_bits))\n            self.desfase\
      \ = d\n            self.marcar = True\n        self.acc[:] = 0.0\n        self.acc_bits\
      \ = 0\n\n    def work(self, input_items, output_items):\n        rx = input_items[0]\n\
      \        out = output_items[0]\n        m = len(rx)\n        idx = self.n +\
      \ np.arange(m)\n\n        d = 0 if self.desfase is None else self.desfase\n\
      \        out[:] = self.trama[(idx - d) % self.L]\n\n        np.add.at(self.acc,\
      \ idx % self.L, 2.0 * (rx & 1) - 1.0)\n        self.acc_bits += m\n        self.n\
      \ += m\n        # Antes de alinearse se evalua seguido (cada 250 bits) para\
      \ fijar el desfase\n        # dentro de los bits de guarda del primer punto;\
      \ despues, cada min_bits.\n        if self.acc_bits >= (250 if self.desfase\
      \ is None else self.min_bits):\n            self._decidir()\n        if self.marcar:\n\
      \            # Ajuste Fase 4 v2: los bits anteriores a este punto se compararon\
      \ con\n            # una referencia desalineada; e_BER_Curve los descarta.\n\
      \            self.add_item_tag(0, self.nitems_written(0) + m - 1,\n        \
      \                      pmt.intern('realineo'), pmt.from_long(self.desfase))\n\
      \            self.marcar = False\n        return m\n"
    affinity: ''
    alias: ''
    comment: 'Referencia Tx (trama conocida) alineada automaticamente

      con los bits recibidos (Tx y Rx en PCs distintos)'
    max_bits: '20000'
    max_salto: '3'
    maxoutbuf: '0'
    min_bits: '2000'
    minoutbuf: '0'
    trama: trama_bits
    z_min: '10.0'
  states:
    _io_cache: ('e_Ref_Alineada', 'blk', [('trama', '(0, 1)'), ('z_min', '10.0'),
      ('max_salto', '3'), ('min_bits', '2000'), ('max_bits', '20000')], [('0', 'byte',
      1)], [('0', 'byte', 1)], '', ['max_bits', 'max_salto', 'min_bits', 'trama',
      'z_min'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2624, 488.0]
    rotation: 0
    state: enabled
- name: e_Texto_Rx
  id: epy_block
  parameters:
    _source_code: "\"\"\"\ne_Texto_Rx\nRama de verificacion visual: reconstruye el\
      \ texto de telemetria a partir de\nlos bits recuperados. NO interviene en la\
      \ medicion BER.\n\nEntrada 0 : bits recuperados por el receptor (byte 0/1, salida\
      \ del Binary Slicer).\n\nBusca la palabra de sincronizacion (ultimos 16 bits\
      \ del preambulo + SFD 0x904E),\ntoma los bits de la carga, quita el blanqueo\
      \ PN9 si pn9 = 1, y compara el texto\ncon el mensaje esperado.\n\nMetodos para\
      \ Function Probe:\n    texto()  -> ultimo texto recibido\n    estado() -> contador\
      \ de tramas correctas / con error\n\"\"\"\n\nimport time\n\nimport numpy as\
      \ np\nfrom gnuradio import gr\n\nSINCRONIA = 0x5555904E      # 0x5555 (fin del\
      \ preambulo) + SFD 0x904E\nSINCRONIA_BITS = 32\nMASCARA = (1 << SINCRONIA_BITS)\
      \ - 1\n\n\nclass blk(gr.sync_block):\n    def __init__(self, mensaje=\"ID:S01\"\
      , pn9=0, max_errores_sincronia=2,\n                 imprimir_cada=1.0):\n  \
      \      gr.sync_block.__init__(\n            self,\n            name='e_Texto_Rx',\n\
      \            in_sig=[np.int8],\n            out_sig=None\n        )\n      \
      \  self.mensaje = str(mensaje)\n        self.pn9 = int(pn9)\n        self.max_errores_sincronia\
      \ = int(max_errores_sincronia)\n        self.imprimir_cada = float(imprimir_cada)\n\
      \n        self.carga_esperada = self._bytes_a_bits(self.mensaje.encode('ascii',\
      \ errors='replace'))\n        if self.pn9:\n            self.carga_esperada\
      \ = self._blanquear(self.carga_esperada)\n        self.n_carga = len(self.carga_esperada)\n\
      \n        self.registro = 0\n        self.capturando = False\n        self.carga\
      \ = []\n\n        self.tramas_ok = 0\n        self.tramas_error = 0\n      \
      \  self.ultimo_texto = '(esperando trama...)'\n        self.ultimo_errores =\
      \ 0\n        self.ultima_impresion = 0.0\n\n    @staticmethod\n    def _bytes_a_bits(datos):\n\
      \        return [(b >> (7 - i)) & 1 for b in datos for i in range(8)]\n\n  \
      \  @staticmethod\n    def _blanquear(bits):\n        # PN9: x^9 + x^5 + 1, semilla\
      \ 0x1FF (igual que trama_telemetria)\n        estado = 0x1FF\n        salida\
      \ = []\n        for b in bits:\n            salida.append(b ^ (estado & 1))\n\
      \            nuevo = (estado ^ (estado >> 5)) & 1\n            estado = (estado\
      \ >> 1) | (nuevo << 8)\n        return salida\n\n    @staticmethod\n    def\
      \ _visible(datos):\n        return ''.join(chr(c) if 32 <= c < 127 else '?'\
      \ for c in datos)\n\n    def _cerrar_trama(self):\n        errores = sum(a !=\
      \ b for a, b in zip(self.carga, self.carga_esperada))\n        bits = self._blanquear(self.carga)\
      \ if self.pn9 else self.carga\n        datos = bytes(\n            sum(bits[k\
      \ + i] << (7 - i) for i in range(8))\n            for k in range(0, len(bits)\
      \ - 7, 8)\n        )\n        self.ultimo_texto = self._visible(datos)\n   \
      \     self.ultimo_errores = errores\n        if errores == 0:\n            self.tramas_ok\
      \ += 1\n        else:\n            self.tramas_error += 1\n\n        ahora =\
      \ time.time()\n        if ahora - self.ultima_impresion >= self.imprimir_cada:\n\
      \            self.ultima_impresion = ahora\n            print('[Rx] %s | %s'\
      \ % (self.ultimo_texto, self.estado()))\n\n    def texto(self):\n        return\
      \ self.ultimo_texto\n\n    def estado(self):\n        total = self.tramas_ok\
      \ + self.tramas_error\n        return 'Tramas OK: %d / %d | errores en la ultima:\
      \ %d bits' % (\n            self.tramas_ok, total, self.ultimo_errores)\n\n\
      \    def work(self, input_items, output_items):\n        for b in input_items[0]:\n\
      \            bit = int(b) & 1\n            if self.capturando:\n           \
      \     self.carga.append(bit)\n                if len(self.carga) == self.n_carga:\n\
      \                    self._cerrar_trama()\n                    self.capturando\
      \ = False\n                    self.registro = 0\n                continue\n\
      \n            self.registro = ((self.registro << 1) | bit) & MASCARA\n     \
      \       if bin(self.registro ^ SINCRONIA).count('1') <= self.max_errores_sincronia:\n\
      \                self.capturando = True\n                self.carga = []\n \
      \       return len(input_items[0])\n"
    affinity: ''
    alias: ''
    comment: Verificacion visual del texto (no afecta la BER)
    imprimir_cada: '1.0'
    max_errores_sincronia: '2'
    maxoutbuf: '0'
    mensaje: mensaje
    minoutbuf: '0'
    pn9: pn9
  states:
    _io_cache: ('e_Texto_Rx', 'blk', [('mensaje', "'ID:S01'"), ('pn9', '0'), ('max_errores_sincronia',
      '2'), ('imprimir_cada', '1.0')], [('0', 'byte', 1)], [], '', ['imprimir_cada',
      'max_errores_sincronia', 'mensaje', 'pn9'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2992, 668.0]
    rotation: 0
    state: enabled
