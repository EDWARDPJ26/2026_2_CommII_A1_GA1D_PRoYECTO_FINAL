options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    comment: 'Fase 4: transmite en bucle una trama de telemetria fija (preambulo + SFD + mensaje)'
    description: Transmisor FSK binario por USRP 2920 con trama de telemetria conocida para medir BER
    generate_options: qt_gui
    id: Transmisor_FSK_USRP_Fase4
    output_language: python
    run: 'True'
    run_options: prompt
    title: 'Transmisor FSK - USRP 2920 (Fase 4: trama de telemetria)'
    window_size: (1400,900)
  states:
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: |-
      Misma tasa para el modulador y el USRP
      (100 MHz / 100 = 1 MS/s, valida en el 2920)
    value: 1e6
  states:
    coordinate:
    - 200
    - 12
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: Muestras por simbolo
    value: '100'
  states:
    coordinate:
    - 312
    - 12
    rotation: 0
    state: enabled
- name: symbol_rate
  id: variable
  parameters:
    comment: ''
    value: samp_rate/sps
  states:
    coordinate:
    - 400
    - 12
    rotation: 0
    state: enabled
- name: fc
  id: variable
  parameters:
    comment: Frecuencia portadora
    value: 870e6
  states:
    coordinate:
    - 520
    - 12
    rotation: 0
    state: enabled
- name: fsk_deviation
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: Desviación FSK (Hz)
    rangeType: float
    start: '5000'
    step: '1000'
    stop: '100000'
    value: '20000'
    widget: counter_slider
  states:
    coordinate:
    - 640
    - 12
    rotation: 0
    state: enabled
- name: tx_gain
  id: variable_qtgui_range
  parameters:
    comment: 'Ganancia TX del 2920 (WBX): 0 a 31.5 dB'
    gui_hint: ''
    label: Ganancia TX (dB)
    rangeType: float
    start: '0'
    step: '0.5'
    stop: '31.5'
    value: '10'
    widget: counter_slider
  states:
    coordinate:
    - 840
    - 12
    rotation: 0
    state: enabled
- name: tx_amp
  id: variable_qtgui_range
  parameters:
    comment: Amplitud digital (<1 para no saturar el DAC)
    gui_hint: ''
    label: Amplitud
    rangeType: float
    start: '0'
    step: '0.01'
    stop: '1'
    value: '0.7'
    widget: counter_slider
  states:
    coordinate:
    - 1024
    - 12
    rotation: 0
    state: enabled
- name: import_0
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import math
  states:
    coordinate:
    - 1208
    - 12
    rotation: 0
    state: enabled
- name: trama_telemetria
  id: epy_module
  parameters:
    alias: ''
    comment: Arma la trama. El mismo modulo va en el receptor.
    source_code: |
      """
      trama_telemetria
      Arma la trama de telemetria de la Fase 4 (formato tipo IEEE 802.15.4g SUN-FSK):

          [preambulo 32 bits 0x55555555][SFD 16 bits 0x904E][carga: mensaje ASCII, MSB primero]

      Si pn9 = 1, la carga se blanquea con la secuencia PN9 (x^9 + x^5 + 1, semilla 0x1FF).
      El preambulo y el SFD nunca se blanquean, para poder detectarlos en el receptor.

      El mismo modulo va en el transmisor y en el receptor, para que ambos tengan
      exactamente la misma secuencia de referencia.
      """

      PREAMBULO = 0x55555555
      PREAMBULO_BITS = 32
      SFD = 0x904E
      SFD_BITS = 16


      def entero_a_bits(valor, n):
          """Entero -> lista de n bits, MSB primero."""
          return [(valor >> (n - 1 - i)) & 1 for i in range(n)]


      def bytes_a_bits(datos):
          """Bytes -> lista de bits, MSB primero en cada byte."""
          return [(b >> (7 - i)) & 1 for b in datos for i in range(8)]


      def bits_a_bytes(bits):
          """Lista de bits (MSB primero) -> bytes. Ignora los bits sobrantes."""
          datos = bytearray()
          for k in range(0, len(bits) - 7, 8):
              b = 0
              for bit in bits[k:k + 8]:
                  b = (b << 1) | (int(bit) & 1)
              datos.append(b)
          return bytes(datos)


      def secuencia_pn9(n):
          """n bits de la PN9 (x^9 + x^5 + 1) con semilla 0x1FF."""
          estado = 0x1FF
          salida = []
          for _ in range(n):
              salida.append(estado & 1)
              nuevo = (estado ^ (estado >> 5)) & 1
              estado = (estado >> 1) | (nuevo << 8)
          return salida


      def blanquear(bits):
          """XOR con la PN9. Aplicarlo dos veces devuelve los bits originales."""
          return [b ^ p for b, p in zip(bits, secuencia_pn9(len(bits)))]


      def carga_bits(mensaje, pn9=0):
          """Bits de la carga (mensaje ASCII), blanqueados si pn9 = 1."""
          bits = bytes_a_bits(str(mensaje).encode('ascii', errors='replace'))
          return blanquear(bits) if int(pn9) else bits


      def construir_trama(mensaje, pn9=0):
          """Trama completa como lista de bits 0/1."""
          return (entero_a_bits(PREAMBULO, PREAMBULO_BITS)
                  + entero_a_bits(SFD, SFD_BITS)
                  + carga_bits(mensaje, pn9))


      def decodificar_carga(bits, pn9=0):
          """Bits de carga recibidos -> texto (para el receptor)."""
          bits = [int(b) & 1 for b in bits]
          if int(pn9):
              bits = blanquear(bits)
          return bits_a_bytes(bits).decode('ascii', errors='replace')
  states:
    coordinate:
    - 24
    - 100
    rotation: 0
    state: enabled
- name: mensaje
  id: variable
  parameters:
    comment: 'Lecturas simuladas FIJAS: el receptor debe conocer el mismo texto'
    value: '"ID:S01;T:24.5C;HR:15%;ALT:2500msnm;P:184kPa;NIV:72%;Q:3.4m3/h"'
  states:
    coordinate:
    - 200
    - 100
    rotation: 0
    state: enabled
- name: pn9
  id: variable
  parameters:
    comment: |-
      0 = carga ASCII sin blanqueo
      1 = carga blanqueada con PN9
      Debe valer lo mismo en el Tx y en el Rx
    value: '0'
  states:
    coordinate:
    - 640
    - 100
    rotation: 0
    state: enabled
- name: trama_bits
  id: variable
  parameters:
    comment: Preambulo 0x55555555 + SFD 0x904E + carga
    value: trama_telemetria.construir_trama(mensaje, pn9)
  states:
    coordinate:
    - 760
    - 100
    rotation: 0
    state: enabled
- name: bit_source
  id: blocks_vector_source_x
  parameters:
    comment: Trama de telemetria repetida en bucle
    repeat: 'True'
    tags: '[]'
    type: byte
    vector: trama_bits
    vlen: '1'
  states:
    coordinate:
    - 24
    - 180
    rotation: 0
    state: enabled
- name: nrz_mapper
  id: digital_chunks_to_symbols_xx
  parameters:
    comment: |-
      bit 0 -> -1 (fc - desviacion)
      bit 1 -> +1 (fc + desviacion)
    dimension: '1'
    in_type: byte
    num_ports: '1'
    out_type: float
    symbol_table: '[-1.0, 1.0]'
  states:
    coordinate:
    - 256
    - 196
    rotation: 0
    state: enabled
- name: symbol_repeat
  id: blocks_repeat
  parameters:
    comment: ''
    interp: sps
    type: float
    vlen: '1'
  states:
    coordinate:
    - 480
    - 204
    rotation: 0
    state: enabled
- name: fsk_modulator
  id: analog_frequency_modulator_fc
  parameters:
    comment: ''
    sensitivity: 2*math.pi*fsk_deviation/samp_rate
  states:
    coordinate:
    - 664
    - 204
    rotation: 0
    state: enabled
- name: amp_scale
  id: blocks_multiply_const_vxx
  parameters:
    comment: ''
    const: tx_amp
    type: complex
    vlen: '1'
  states:
    coordinate:
    - 904
    - 204
    rotation: 0
    state: enabled
- name: uhd_usrp_sink_0
  id: uhd_usrp_sink
  parameters:
    ant0: '"TX/RX"'
    center_freq0: fc
    clock_rate: 0e0
    comment: 'USRP 2920: sin GPSDO -> Sync = none'
    dev_addr: '""'
    dev_args: ''
    gain0: tx_gain
    nchan: '1'
    num_mboards: '1'
    samp_rate: samp_rate
    sync: none
    type: fc32
  states:
    coordinate:
    - 1136
    - 172
    rotation: 0
    state: enabled
- name: tx_spectrum
  id: qtgui_freq_sink_x
  parameters:
    autoscale: 'False'
    average: '0.2'
    axislabels: 'True'
    bw: samp_rate
    comment: ''
    ctrlpanel: 'False'
    fc: fc
    fftsize: '2048'
    freqhalf: 'True'
    grid: 'True'
    gui_hint: ''
    label1: Tx
    legend: 'True'
    name: '"Espectro FSK transmitido"'
    nconnections: '1'
    showports: 'False'
    type: complex
    units: dB
    update_time: '0.10'
    wintype: window.WIN_BLACKMAN_hARRIS
    ymax: '10'
    ymin: '-140'
  states:
    coordinate:
    - 1136
    - 360
    rotation: 0
    state: enabled
connections:
- - bit_source
  - '0'
  - nrz_mapper
  - '0'
- - nrz_mapper
  - '0'
  - symbol_repeat
  - '0'
- - symbol_repeat
  - '0'
  - fsk_modulator
  - '0'
- - fsk_modulator
  - '0'
  - amp_scale
  - '0'
- - amp_scale
  - '0'
  - uhd_usrp_sink_0
  - '0'
- - amp_scale
  - '0'
  - tx_spectrum
  - '0'
metadata:
  file_format: 1
  grc_version: 3.10.12.0
